# URL base de la API Laravel (incluye /api)
# Recomendado en local con `php artisan serve`:
VITE_API_URL=http://localhost:8000/api
#
# Alternativa con proxy Vite (mismo origen, sin CORS):
# VITE_API_URL=/api
# y en vite.config.ts el proxy hacia el backend.
#
# XAMPP (solo si el DocumentRoot/alias responde bien):
# VITE_API_URL=http://localhost/sipart/public/api
